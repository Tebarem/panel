{
    "$schema": "../../packages/sdk/manifest.schema.json",
    "id": "ramjet-theme",
    "name": "Ramjet Theme",
    "version": "1.0.0",
    "description": "The ramjet.gg look for the panel: near-black surfaces, afterburner-orange brand colour, Archivo headings and the Ramjet emblem. Token overrides only.",
    "author": "Ramjet",
    "provider": "Ramjet\\Theme\\RamjetThemeProvider",
    "autoload": {
        "Ramjet\\Theme\\": "src"
    },
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": "^2.0.0-beta.4",
        "php": "^8.3"
    },
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "rjtheme"
    }
}
