<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.0/phpunit.xsd" bootstrap="bootstrap.php" colors="true">
  <testsuites>
    <testsuite name="ramjet-theme">
      <directory>./</directory>
    </testsuite>
  </testsuites>
  <php>
    <env name="APP_ENV" value="testing"/>
    <env name="CACHE_STORE" value="array"/>
    <env name="MAIL_MAILER" value="array"/>
    <env name="QUEUE_CONNECTION" value="sync"/>
    <!-- "(false)" rather than "false": PHPUnit turns "false" into an empty string. -->
    <env name="RECAPTCHA_ENABLED" value="(false)"/>
    <env name="SESSION_DRIVER" value="array"/>
    <env name="PTERODACTYL_EXTENSIONS_DIRECTORY" value="tests/Fixtures/extensions"/>
    <env name="APP_URL" value="https://panel.ramjet.gg"/>
    <env name="APP_NAME" value="Ramjet"/>
  </php>
</phpunit>
